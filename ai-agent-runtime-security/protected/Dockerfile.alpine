FROM python:3.14.10-alpine3.24

ENV AGENT_MODE=protected \
    AGENT_WORKSPACE_ROOT=/workspace \
    AUDIT_LOG=/workspace/output/tool-audit.jsonl \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY protected/agent/agent.py /app/agent.py

RUN apk upgrade --no-cache \
    && python -m pip uninstall -y pip \
    && apk del .python-rundeps \
    && rm -rf \
        /usr/local/lib/python3.14/ensurepip \
        /usr/local/lib/python3.14/site-packages/pip \
        /usr/local/lib/python3.14/site-packages/pip-*.dist-info \
        /usr/local/lib/python3.14/lib-dynload/_sqlite3*.so \
    && python -c "import importlib.util; assert importlib.util.find_spec('pip') is None; assert importlib.util.find_spec('ensurepip') is None" \
    && adduser -D -u 10001 -H -s /bin/false agentuser \
    && chown root:root /app /app/agent.py \
    && chmod 0555 /app \
    && chmod 0444 /app/agent.py \
    && mkdir -p /workspace/fixtures /workspace/output \
    && chown root:root /workspace /workspace/fixtures \
    && chmod 0755 /workspace \
    && chmod 0555 /workspace/fixtures \
    && chown 10001:10001 /workspace/output \
    && chmod 0700 /workspace/output

USER 10001:10001

WORKDIR /workspace

ENTRYPOINT ["python", "/app/agent.py"]
