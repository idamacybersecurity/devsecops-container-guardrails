{
  "format_version": "1.2",
  "terraform_version": "1.17.2",
  "resource_changes": [
    {
      "address": "aws_iam_role_policy.safe",
      "mode": "managed",
      "type": "aws_iam_role_policy",
      "change": {
        "actions": [
          "create"
        ],
        "after": {
          "policy": {
            "Statement": [
              {
                "Effect": "Allow",
                "Action": [
                  "sts:AssumeRole"
                ],
                "Resource": "arn:aws:iam::000000000000:role/example"
              }
            ]
          }
        }
      }
    },
    {
      "address": "aws_s3_bucket.audit",
      "mode": "managed",
      "type": "aws_s3_bucket",
      "change": {
        "actions": [
          "create"
        ],
        "after": {
          "server_side_encryption_configuration": [
            {
              "rule": [
                {
                  "apply_server_side_encryption_by_default": [
                    {
                      "sse_algorithm": "aws:kms",
                      "kms_master_key_id": "arn:aws:kms:eu-north-1:000000000000:key/example"
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    {
      "address": "aws_secretsmanager_secret.config",
      "mode": "managed",
      "type": "aws_secretsmanager_secret",
      "change": {
        "actions": [
          "create"
        ],
        "after": {
          "kms_key_id": "arn:aws:kms:eu-north-1:000000000000:key/example"
        }
      }
    },
    {
      "address": "aws_security_group.app",
      "mode": "managed",
      "type": "aws_security_group",
      "change": {
        "actions": [
          "create"
        ],
        "after": {
          "ingress": [
            {
              "protocol": "tcp",
              "from_port": 443,
              "to_port": 443,
              "cidr_blocks": [
                "10.40.1.0/24"
              ],
              "ipv6_cidr_blocks": []
            }
          ],
          "egress": [
            {
              "protocol": "-1",
              "cidr_blocks": [
                "0.0.0.0/0"
              ],
              "ipv6_cidr_blocks": []
            }
          ]
        }
      }
    }
  ]
}
